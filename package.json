{
  "name": "fractal-noise",
  "version": "3.0.0",
  "description": "Fractal noise library",
  "keywords": [
    "noise",
    "procedural-generation"
  ],
  "homepage": "https://github.com/joshforisha/fractal-noise#readme",
  "author": "Josh Forisha <josh@forisha.com>",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshforisha/fractal-noise.git"
  },
  "bugs": {
    "url": "https://github.com/joshforisha/fractal-noise/issues"
  },
  "files": [
    "lib/"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/mod.d.ts",
      "default": "./lib/mod.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "tsc",
    "format": "prettier --check .",
    "test": "tsc --noEmit -p tsconfig.test.json && node --test",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsr": "^0.14.3",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
